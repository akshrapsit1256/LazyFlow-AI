# LazyFlow AI Backend Configuration Example
# Copy this file to .env to customize your settings

# Ollama Server Endpoint (Default local Ollama port)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Configured Open-Weight Model (e.g. gemma2:2b, gemma2:9b, llama3.2, mistral)
OLLAMA_MODEL=gemma2:2b

# Request Timeout in seconds for local AI inference
OLLAMA_TIMEOUT=90.0

# SQLite Database Location
DATABASE_URL=sqlite:///./lazyflow.db
